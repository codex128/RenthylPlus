
const vec3 voxelSize = (GRID_MAX - GRID_MIN) / GRID_SIZE;
const vec3 gridSizeInverse = 1.0 / (GRID_MAX - GRID_MIN);
const mat3 seedScalars = mat3(1.0, 1.56, 0.68, 0.91, 0.33, 1.87, 1.34, 1.79, 0.48);

#ifndef TRACE_DISPLACEMENT
    #define TRACE_DISPLACEMENT 0.0
#endif

vec3 worldToVoxelSpace(vec3 worldPos) {
    return (worldPos - GRID_MIN) * gridSizeInverse;
}

bool withinVoxelGridBounds(vec3 worldPos, float radius) {
    vec3 lower = GRID_MIN - radius;
    vec3 upper = GRID_MAX + radius;
    return worldPos.x >= lower.x && worldPos.x < upper.x
        && worldPos.y >= lower.y && worldPos.y < upper.y
        && worldPos.z >= lower.z && worldPos.z < upper.z;
}

vec3 orthogonal(vec3 vec) {
    vec3 w = vec3(0.0, 1.0, 0.0);
    if (dot(vec, w) > 0.9) {
        w = vec3(1.0, 0.0, 0.0);
    }
    return normalize(cross(vec, w));
}

float maxVoxelSize() {
    return max(max(voxelSize.x, voxelSize.y), voxelSize.z);
}

float interpolateLinear(float a, float b, float f) {
    return (b - a) * f + a;
}

vec3 random3(vec3 v){
    v = fract(v * vec3(443.897, 441.423, 437.195));
    v += dot(v, v.zxy + vec3(31.31));
    return normalize(fract((v.xyz + v.yzx) * v.zyx));
}

vec3 randomHemisphere(mat3 space, float seed) {
    vec3 v = fract(vec3(443.897, 441.423, 437.195) * seed);
    v += dot(v, v.zxy + vec3(31.31));
    v = normalize(fract((v.xyz + v.yzx) * v.zyx));
    v.z = abs(v.z);
    return space * v;
}

vec3 traceVoxelCone(vec3 origin, vec3 direction, float apertureTan2, float quality) {
    direction = normalize(direction);
    float maxVoxSize = maxVoxelSize();
    float dist = maxVoxSize * TRACE_DISPLACEMENT;
    quality = max(0.1, quality);
    vec4 color = vec4(0.0);
    float voxSizeInverse = 1.0 / maxVoxSize;
    // trace until the color opacity has been saturated or the cone
    // leaves the voxel grid boundaries
    while (color.a < 1.0) {
        float diameter = max(maxVoxSize, dist * apertureTan2);
        vec3 pos = origin + direction * dist;
        if (!withinVoxelGridBounds(pos, diameter * 0.35)) {
            break;
        }
        float lod = log2(diameter * voxSizeInverse);
        color += textureLod(TRACING_VOXEL_MAP, worldToVoxelSpace(pos), lod) * (1.0 - color.a);
        dist += diameter * quality;
    }
    return color.rgb;
}

vec3 traceVoxelConeAngle(vec3 origin, vec3 direction, float angle, float quality) {
    return traceVoxelCone(origin, direction, 2.0 * tan(angle), quality);
}

vec3 approximateSurfaceIndirectVXGI(vec3 worldPos, mat3 tanSpace, vec3 worldNormal, vec3 viewDir, float metallic, float roughness, vec3 specular, float quality) {
    float angle = radians(30.0);
    float apertureTan2 = 2.0 * tan(angle);
    worldPos += worldNormal * maxVoxelSize() * 2.2;
    // diffuse
    vec3 color = traceVoxelCone(worldPos, tanSpace * vec3(0.0, 0.0, 1.0), apertureTan2, quality) * roughness;
    color += traceVoxelCone(worldPos, tanSpace * vec3(1.0, 0.0, 1.0), apertureTan2, quality) * roughness;
    color += traceVoxelCone(worldPos, tanSpace * vec3(-1.0, 0.0, 1.0), apertureTan2, quality) * roughness;
    color += traceVoxelCone(worldPos, tanSpace * vec3(0.0, 1.0, 1.0), apertureTan2, quality) * roughness;
    color += traceVoxelCone(worldPos, tanSpace * vec3(0.0, -1.0, 1.0), apertureTan2, quality) * roughness;
    // specular
    color += traceVoxelConeAngle(worldPos, reflect(viewDir, worldNormal), interpolateLinear(0.01, angle, roughness), quality) * specular;
    return color;
}

vec3 approximateSurfaceIndirectVXGI(vec3 worldPos, vec3 worldNormal, vec3 viewDir, float metallic, float roughness, vec3 specular, float quality) {
    // build tangent space matrix
    vec3 xtan = orthogonal(worldNormal);
    vec3 ytan = cross(worldNormal, xtan);
    mat3 tanSpace = mat3(xtan, ytan, worldNormal);
    return approximateSurfaceIndirectVXGI(worldPos, tanSpace, worldNormal, viewDir, metallic, roughness, specular, quality);
}

vec3 approximatePositionIndirectVXGI(vec3 worldPos, vec3 bias, float quality, float seed) {
    float angle = radians(30.0);
    float apertureTan2 = 2.0 * tan(angle);
    vec3 xtan = orthogonal(bias);
    vec3 ytan = cross(bias, xtan);
    mat3 tanSpace = mat3(xtan, ytan, bias);
    vec3 color = traceVoxelCone(worldPos, randomHemisphere(tanSpace, seed), apertureTan2, quality);
    color += traceVoxelCone(worldPos, randomHemisphere(tanSpace, seed * 1.353), apertureTan2, quality);
    color += traceVoxelCone(worldPos, randomHemisphere(tanSpace, seed * 1.831), apertureTan2, quality);
    return color;
}




#ifdef DIFFUSE_TRACE_PATTERN
    uniform vec3 m_DiffuseTracePattern[];
#else
    const vec3 m_DiffuseTracePattern[9] = vec3[9](
        vec3(0.0, 0.0, 1.0), vec3(1.0, 0.0, 1.0), vec3(-1.0, 0.0, 1.0),
        vec3(0.0, 1.0, 1.0), vec3(0.0, -1.0, 1.0), vec3(1.0, 1.0, 1.0),
        vec3(1.0, -1.0, 1.0), vec3(-1.0, 1.0, 1.0), vec3(-1.0, -1.0, 1.0)
    );
#endif

// generates a vector perpendicular to the argument
vec3 perpendicular(vec3 v) {
    vec3 w = normalize(vec3(0.1, 0.0, 1.0));
    if (abs(dot(v, w)) >= 0.9) {
        w = normalize(vec3(1.0, 0.0, 1.0));
    }
    return normalize(cross(v, w));
}

vec3 toVoxelSpace(vec3 projCoord) {
    return (projCoord + 1.0) * 0.5;
}

vec3 traceCone(vec3 origin, vec3 direction, float apertureTan2) {
    vec4 color = vec4(0.0);
    float dist = 0.0;
    float a = max(voxelSize, apertureTan2);
    while (color.a < 1.0) {
        float diameter = max(voxelSize, dist * a);
        float lod = log2(diameter * voxelCount);
        vec3 pos = origin + direction * dist;
        if (!insideVoxelMap(pos)) {
            break;
        }
        vec4 voxel = textureLod(m_VoxelMapPrev, pos, max(1.0, lod));
        color += (1 - color.a) * voxel;
        dist += diamater * 0.7;
    }
    return color.rgb;
}

vec3 traceDiffuseSurface(vec3 position, vec3 normal, float angle, int traces) {
    float apertureTan2 = 2.0 * tan(angle * 0.5);
    vec3 x = perpendicular(normal);
    vec3 y = cross(normal, x);
    mat3 tanSpace = mat3(xtan, ytan, normal);
    vec3 color = vec3(0.0);
    for (int i = 0; i < traces; i++) {
        vec3 dir = normalize(tanSpace * m_DiffuseTracePattern[i]);
        color += traceCone(position, dir, apertureTan2);
    }
    return color;
}

